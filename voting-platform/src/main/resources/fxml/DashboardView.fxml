<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="620.0" prefWidth="960.0"
            style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.client.controller.DashboardController">

    <!-- Top bar -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="52.0"
              style="-fx-background-color: #1a6b3a; -fx-padding: 0 28;">
            <Label text="⚖  SecureVote 2026"
                   style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold;" />
            <Label text="  —  Voter Dashboard"
                   style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13;" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="6.0"
                  style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 3; -fx-padding: 6 14; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 3;">
                <Label text="Time Remaining:"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 11;" />
                <Label fx:id="timerLabel" text="00:00:00"
                       style="-fx-text-fill: #7ec8a0; -fx-font-size: 13; -fx-font-weight: bold;" />
            </HBox>
        </HBox>
    </top>

    <!-- Main -->
    <center>
        <SplitPane dividerPositions="0.27"
                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0;">

            <!-- Left: candidate list -->
            <VBox spacing="10.0"
                  style="-fx-background-color: #f0ede6; -fx-border-color: transparent #ddd8ce transparent transparent; -fx-border-width: 0 1 0 0; -fx-padding: 20;">
                <Label text="Candidates"
                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1a3a2a;" />
                <Label text="Select one to view their profile"
                       style="-fx-font-size: 11; -fx-text-fill: #8a9a8a;" />
                <ListView fx:id="candidateListView" VBox.vgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-border-color: #c8d8c8; -fx-border-radius: 4; -fx-background-radius: 4;" />
            </VBox>

            <!-- Right: candidate detail -->
            <VBox fx:id="campaignZone" spacing="18.0"
                  style="-fx-background-color: #f9f7f2; -fx-padding: 24;">

                <VBox spacing="3.0">
                    <Label fx:id="candidateNameLabel" text="Select a candidate"
                           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1a3a2a;" />
                    <Label fx:id="partyLabel" text="—"
                           style="-fx-font-size: 13; -fx-text-fill: #5a7a6a;" />
                </VBox>

                <HBox spacing="16.0" VBox.vgrow="ALWAYS">

                    <!-- Manifesto -->
                    <VBox spacing="16.0" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-border-color: #c8d8c8; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 16;">
                        <Label text="Campaign Manifesto"
                               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1a3a2a;" />
                        <Label fx:id="manifestoSummaryLabel" text="Click the link below to read this candidate's manifesto."
                               style="-fx-font-size: 12; -fx-text-fill: #5a7a6a;" wrapText="true" />
                        <Hyperlink fx:id="manifestoLink" text="No manifesto available" onAction="#handleOpenManifesto"
                                   style="-fx-font-size: 13; -fx-text-fill: #1a6b3a;" />
                    </VBox>

                    <!-- Video -->
                    <VBox alignment="CENTER_LEFT" spacing="16.0" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-border-color: #c8d8c8; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 16;">
                        <Label text="Campaign Video"
                               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1a3a2a;" />
                        <Label fx:id="videoSummaryLabel" text="Open the campaign video link to learn more."
                               style="-fx-font-size: 12; -fx-text-fill: #5a7a6a;" wrapText="true" />
                        <Hyperlink fx:id="videoLink" text="No video available" onAction="#handleOpenVideo"
                                   style="-fx-font-size: 13; -fx-text-fill: #1a6b3a;" />
                    </VBox>

                </HBox>
            </VBox>
        </SplitPane>
    </center>

    <!-- Bottom bar -->
    <bottom>
        <HBox alignment="CENTER_LEFT" prefHeight="52.0"
              style="-fx-background-color: #edeae2; -fx-border-color: #ddd8ce transparent transparent transparent; -fx-border-width: 1 0 0 0; -fx-padding: 0 24;">
            <Label fx:id="voterSessionLabel" text="Logged in as: —"
                   style="-fx-font-size: 12; -fx-text-fill: #7a8a7a;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Proceed to Vote →" onAction="#handleGoToVoting"
                    prefHeight="38.0" prefWidth="180.0"
                    style="-fx-background-color: #1a3a2a; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 4; -fx-cursor: hand;" />
        </HBox>
    </bottom>

</BorderPane>
