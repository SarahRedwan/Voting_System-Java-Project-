<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.client.controller.WelcomeController"
      prefWidth="860.0" prefHeight="540.0"
      style="-fx-background-color: white;">

    <HBox alignment="CENTER_LEFT" prefHeight="48.0"
          style="-fx-background-color: #1a6b3a; -fx-padding: 0 28;">
        <Label text="FEDERAL ELECTORAL COMMISSION  —  SECUREVOTE 2026"
               style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 10.5; -fx-font-weight: bold;" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="🔒 Encrypted  ·  Audited  ·  Verified"
               style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 10;" />
    </HBox>

    <VBox alignment="CENTER" VBox.vgrow="ALWAYS" spacing="0.0">
        <VBox alignment="CENTER" spacing="8.0" style="-fx-padding: 0 0 36 0;">
            <Label text="🗳" style="-fx-font-size: 56;" />
            <Label text="SecureVote 2026"
                   style="-fx-font-size: 38; -fx-font-weight: bold; -fx-text-fill: #1a6b3a;">
                <font><Font name="System Bold" size="38.0" /></font>
            </Label>
            <Label text="National Digital Voting Platform"
                   style="-fx-font-size: 14; -fx-text-fill: #4a9a6a;" />
        </VBox>

        <HBox alignment="CENTER" style="-fx-padding: 0 0 36 0;">
            <Region prefWidth="320.0" prefHeight="1.5"
                    style="-fx-background-color: #c8e8d8;" />
        </HBox>

        <VBox alignment="CENTER" spacing="12.0" maxWidth="300.0">
            <Button text="Sign In to Your Account"
                    onAction="#handleVoterLoginNavigation"
                    prefWidth="300.0" prefHeight="48.0"
                    style="-fx-background-color: #1a6b3a; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" />
            <Button text="Create a New Account"
                    onAction="#handleCreateAccountNavigation"
                    prefWidth="300.0" prefHeight="44.0"
                    style="-fx-background-color: white; -fx-text-fill: #1a6b3a; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-color: #1a6b3a; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-cursor: hand;" />
        </VBox>
    </VBox>

    <HBox alignment="CENTER" prefHeight="36.0"
          style="-fx-background-color: #f0f8f4;">
        <Label text="Authorised by the National Electoral Board  ·  All votes are encrypted and tamper-proof"
               style="-fx-text-fill: #6a9a7a; -fx-font-size: 10;" />
    </HBox>
</VBox>
