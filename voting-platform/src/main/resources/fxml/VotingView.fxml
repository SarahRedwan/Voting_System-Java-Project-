<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="20.0" prefWidth="600.0" prefHeight="400.0"
      xmlns="http://javafx.com/javafx/24" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.client.controller.VotingController"
      style="-fx-background-color: #f4f6f9;">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>

    <Label text="Active Election: 2026 Executive Board" wrapText="true">
        <font>
            <Font name="System Bold" size="22.0" />
        </font>
    </Label>
    <Label text="Please select your candidate for President below:" textFill="#666666">
        <font>
            <Font size="14.0" />
        </font>
    </Label>

    <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
        <children>
            <fx:define>
                <ToggleGroup fx:id="candidateGroup" />
            </fx:define>

            <RadioButton fx:id="candidate1" text="Candidate A (Progressive Party)" toggleGroup="$candidateGroup">
                <font>
                    <Font size="16.0" />
                </font>
            </RadioButton>

            <RadioButton fx:id="candidate2" text="Candidate B (Unity Coalition)" toggleGroup="$candidateGroup">
                <font>
                    <Font size="16.0" />
                </font>
            </RadioButton>

            <RadioButton fx:id="candidate3" text="Candidate C (Independent)" toggleGroup="$candidateGroup">
                <font>
                    <Font size="16.0" />
                </font>
            </RadioButton>
        </children>
    </VBox>

    <HBox spacing="20.0" alignment="CENTER">
        <Button text="Cancel" onAction="#handleCancel"
                style="-fx-background-color: #e0e0e0; -fx-text-fill: #333333; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 5;"/>
        <Button text="Submit Secure Vote" onAction="#handleSubmitVote"
                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 5; -fx-cursor: hand;"/>
    </HBox>

    <Label fx:id="statusLabel" textFill="#e91e63" />
</VBox>