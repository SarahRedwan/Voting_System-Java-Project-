<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.client.controller.LoginController"
      prefWidth="860.0" prefHeight="540.0"
      style="-fx-background-color: white;">

    <HBox alignment="CENTER_LEFT" prefHeight="48.0"
          style="-fx-background-color: #1a6b3a; -fx-padding: 0 28;">
        <Label text="SECUREVOTE 2026  —  SIGN IN"
               style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 10.5; -fx-font-weight: bold;" />
    </HBox>

    <HBox VBox.vgrow="ALWAYS">
        <VBox alignment="CENTER" prefWidth="300.0" spacing="16.0"
              style="-fx-background-color: #f0f8f4; -fx-padding: 40; -fx-border-color: transparent #c8e8d8 transparent transparent; -fx-border-width: 0 1 0 0;">
            <Label text="🗳" style="-fx-font-size: 48;" />
            <Label text="SecureVote" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1a6b3a;" />
            <Label text="2026" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #2e9d5a;" />
            <Region prefHeight="20.0" />
            <Label text="Your vote is secret.&#10;Your identity is verified.&#10;Your voice matters."
                   style="-fx-text-fill: #4a7a5a; -fx-font-size: 12; -fx-text-alignment: center;"
                   wrapText="true" alignment="CENTER" />
        </VBox>

        <VBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="0.0"
              style="-fx-padding: 50 60;">
            <VBox spacing="6.0" style="-fx-padding: 0 0 28 0;">
                <Label text="Welcome back"
                       style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1a6b3a;" />
                <Label text="Sign in with your Voter ID or username"
                       style="-fx-font-size: 13; -fx-text-fill: #6a8a7a;" />
            </VBox>

            <VBox spacing="16.0">
                <VBox spacing="5.0">
                    <Label text="Username / Voter ID"
                           style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #2a5a3a;" />
                    <TextField fx:id="voterIdField" promptText="Enter your ID"
                               style="-fx-background-color: white; -fx-border-color: #a8d8b8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-pref-height: 42; -fx-font-size: 13; -fx-padding: 0 12;" />
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Password"
                           style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #2a5a3a;" />
                    <PasswordField fx:id="passwordField" promptText="Enter your password"
                                   style="-fx-background-color: white; -fx-border-color: #a8d8b8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-pref-height: 42; -fx-font-size: 13; -fx-padding: 0 12;" />
                </VBox>

                <Label fx:id="errorLabel" wrapText="true"
                       style="-fx-text-fill: #c0392b; -fx-font-size: 12;" />

                <Button text="Sign In" onAction="#handleLoginSubmit"
                        prefWidth="340.0" prefHeight="44.0"
                        style="-fx-background-color: #1a6b3a; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" />

                <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-padding: 4 0 0 0;">
                    <Button text="Create an account" onAction="#handleOpenRegistration"
                            style="-fx-background-color: transparent; -fx-text-fill: #1a6b3a; -fx-font-size: 12; -fx-font-weight: bold; -fx-cursor: hand; -fx-underline: true;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="← Back" onAction="#handleBackToWelcome"
                            style="-fx-background-color: transparent; -fx-text-fill: #8a9a8a; -fx-font-size: 12; -fx-cursor: hand;" />
                </HBox>
            </VBox>
        </VBox>
    </HBox>

    <HBox alignment="CENTER" prefHeight="36.0"
          style="-fx-background-color: #f0f8f4;">
        <Label text="Authorised by the National Electoral Board  ·  All votes are encrypted and tamper-proof"
               style="-fx-text-fill: #6a9a7a; -fx-font-size: 10;" />
    </HBox>
</VBox>
