<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" prefWidth="600.0" prefHeight="400.0"
      style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.client.controller.LoginController">

    <children>
        <Label text="Voter Authentication" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="28.0" />
            </font>
        </Label>

        <VBox maxWidth="300.0" spacing="15.0">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Voter Registration ID" textFill="#34495e" />
                        <TextField fx:id="voterIdField" promptText="Enter your ID"
                                   style="-fx-pref-height: 35; -fx-background-radius: 5;" />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Security PIN / Password" textFill="#34495e" />
                        <PasswordField fx:id="passwordField" promptText="Enter your PIN"
                                       style="-fx-pref-height: 35; -fx-background-radius: 5;" />
                    </children>
                </VBox>

                <Label fx:id="errorLabel" textFill="#e74c3c" wrapText="true" />

                <Button mnemonicParsing="false" onAction="#handleLoginSubmit"
                        prefWidth="300.0" prefHeight="40.0"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"
                        text="Sign In securely" />

                <Button mnemonicParsing="false" onAction="#handleBackToWelcome"
                        prefWidth="300.0" prefHeight="30.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d;"
                        text="← Back to Welcome Screen" />
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>