<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.client.controller.VotingController"
           prefWidth="900.0" prefHeight="580.0">

    <VBox style="-fx-background-color: white;" />

    <VBox alignment="CENTER" spacing="0.0">

        <VBox maxWidth="560.0" spacing="0.0"
              style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #a8d8b8; -fx-border-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 20, 0, 0, 4);">
            <padding><Insets top="40.0" bottom="40.0" left="44.0" right="44.0" /></padding>

            <!-- Header -->
            <VBox spacing="6.0" alignment="CENTER" style="-fx-padding: 0 0 28 0;">
                <Label text="🗳️" style="-fx-font-size: 36;" />
                <Label text="Cast Your Vote"
                       style="-fx-text-fill: #1a6b3a; -fx-font-size: 26; -fx-font-weight: bold;" />
                <Label text="Active Election: 2026 Executive Board"
                       style="-fx-text-fill: #6a8a7a; -fx-font-size: 13;" />
            </VBox>

            <!-- Instruction -->
            <Label text="Select your preferred candidate for President:"
                   style="-fx-text-fill: #4a6a5a; -fx-font-size: 13; -fx-padding: 0 0 16 0;" />

            <!-- Candidate options -->
            <VBox spacing="10.0" style="-fx-padding: 0 0 24 0;">
                <fx:define><ToggleGroup fx:id="candidateGroup" /></fx:define>

                <HBox alignment="CENTER_LEFT" spacing="14.0" prefHeight="52.0"
                      style="-fx-background-color: #f0f8f4; -fx-background-radius: 10; -fx-border-color: #a8d8b8; -fx-border-radius: 10; -fx-padding: 0 16; -fx-cursor: hand;">
                    <RadioButton fx:id="candidate1" text="Candidate A  —  Progressive Party"
                                 toggleGroup="$candidateGroup"
                                 style="-fx-text-fill: #1a6b3a; -fx-font-size: 14;" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="14.0" prefHeight="52.0"
                      style="-fx-background-color: #f0f8f4; -fx-background-radius: 10; -fx-border-color: #a8d8b8; -fx-border-radius: 10; -fx-padding: 0 16; -fx-cursor: hand;">
                    <RadioButton fx:id="candidate2" text="Candidate B  —  Unity Coalition"
                                 toggleGroup="$candidateGroup"
                                 style="-fx-text-fill: #1a6b3a; -fx-font-size: 14;" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="14.0" prefHeight="52.0"
                      style="-fx-background-color: #f0f8f4; -fx-background-radius: 10; -fx-border-color: #a8d8b8; -fx-border-radius: 10; -fx-padding: 0 16; -fx-cursor: hand;">
                    <RadioButton fx:id="candidate3" text="Candidate C  —  Independent"
                                 toggleGroup="$candidateGroup"
                                 style="-fx-text-fill: #1a6b3a; -fx-font-size: 14;" />
                </HBox>
            </VBox>

            <!-- Status -->
            <Label fx:id="statusLabel" wrapText="true" maxWidth="472.0"
                   style="-fx-text-fill: #c0392b; -fx-font-size: 12; -fx-padding: 0 0 12 0;" />

            <!-- Actions -->
            <HBox spacing="14.0" alignment="CENTER">
                <Button text="Cancel" onAction="#handleCancel"
                        prefWidth="160.0" prefHeight="44.0"
                        style="-fx-background-color: white; -fx-text-fill: #4a6a5a; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-color: #a8d8b8; -fx-border-radius: 10; -fx-cursor: hand;" />
                <Button text="Submit Secure Vote" onAction="#handleSubmitVote"
                        prefWidth="260.0" prefHeight="44.0"
                        style="-fx-background-color: #1a6b3a; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" />
            </HBox>

        </VBox>
    </VBox>
</StackPane>
