<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="620.0" prefWidth="920.0"
            style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.client.controller.CandidateDashboardController">

    <!-- Top bar -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="52.0"
              style="-fx-background-color: #1a6b3a; -fx-padding: 0 28;">
            <Label text="⚖  SecureVote 2026"
                   style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold;" />
            <Label text="  —  Candidate Console"
                   style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Logout" onAction="#handleLogout"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12; -fx-border-color: rgba(255,255,255,0.25); -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 6 14; -fx-cursor: hand;" />
        </HBox>
    </top>

    <!-- Main -->
    <center>
        <HBox spacing="0.0">

            <!-- Left sidebar: profile -->
            <VBox prefWidth="260.0" spacing="20.0"
                  style="-fx-background-color: #f0ede6; -fx-border-color: transparent #ddd8ce transparent transparent; -fx-border-width: 0 1 0 0; -fx-padding: 28 20;">

                <Label text="Your Profile"
                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1a3a2a;" />

                <VBox spacing="4.0"
                      style="-fx-background-color: white; -fx-border-color: #c8d8c8; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 14;">
                    <Label text="NAME"
                           style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #8a9a8a;" />
                    <Label fx:id="candidateNameLabel" text="—"
                           style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1a3a2a;"
                           wrapText="true" />
                </VBox>

                <VBox spacing="4.0"
                      style="-fx-background-color: white; -fx-border-color: #c8d8c8; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 14;">
                    <Label text="SUBMISSION STATUS"
                           style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #8a9a8a;" />
                    <Label fx:id="queueStatusLabel" text="NO ACTIVE SUBMISSIONS"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #5a7a6a;" />
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <!-- Danger zone -->
                <VBox spacing="8.0"
                      style="-fx-background-color: #fff5f5; -fx-border-color: #f5c6c6; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 14;">
                    <Label text="WITHDRAW CANDIDACY"
                           style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #c0392b;" />
                    <Label text="This permanently removes you from the election."
                           style="-fx-font-size: 11; -fx-text-fill: #8a6a6a;" wrapText="true" />
                    <Button text="Withdraw" onAction="#handleWithdraw"
                            prefWidth="220.0" prefHeight="36.0"
                            style="-fx-background-color: white; -fx-text-fill: #c0392b; -fx-font-size: 12; -fx-font-weight: bold; -fx-border-color: #e0a0a0; -fx-border-radius: 3; -fx-background-radius: 3; -fx-cursor: hand;" />
                    <Label fx:id="withdrawStatusLabel" wrapText="true"
                           style="-fx-font-size: 11;" />
                </VBox>

            </VBox>

            <!-- Right: upload area -->
            <VBox HBox.hgrow="ALWAYS" spacing="20.0" style="-fx-padding: 28 32;">

                <VBox spacing="4.0">
                    <Label text="Upload Campaign Materials"
                           style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1a3a2a;" />
                    <Label text="Submit your assets for review before they are published to voters."
                           style="-fx-font-size: 12; -fx-text-fill: #7a8a7a;" />
                </VBox>

                <!-- PDF row -->
                <VBox spacing="8.0"
                      style="-fx-background-color: white; -fx-border-color: #c8d8c8; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 16;">
                    <Label text="Campaign Manifesto  (PDF)"
                           style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #3a5a4a;" />
                    <HBox spacing="12.0" alignment="CENTER_LEFT">
                        <Button text="Choose File" onAction="#handleUploadPDF"
                                style="-fx-background-color: #f0ede6; -fx-text-fill: #1a3a2a; -fx-font-size: 12; -fx-border-color: #c8c0b0; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 7 14; -fx-cursor: hand;" />
                        <Label fx:id="pdfPathLabel" text="No file selected"
                               style="-fx-font-size: 12; -fx-text-fill: #8a9a8a;" wrapText="true" maxWidth="320.0" />
                    </HBox>
                </VBox>

                <!-- Video row -->
                <VBox spacing="12.0"
                      style="-fx-background-color: white; -fx-border-color: #c8d8c8; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 16;">
                    <Label text="Campaign Video  (optional)"
                           style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #3a5a4a;" />
                    <HBox spacing="16.0" alignment="CENTER_LEFT">
                        <RadioButton fx:id="videoLinkRadio" text="Provide a URL" selected="true"
                                     style="-fx-font-size: 12; -fx-text-fill: #1a3a2a;" onAction="#handleVideoToggle">
                            <toggleGroup><ToggleGroup fx:id="videoToggleGroup" /></toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="videoFileRadio" text="Upload MP4"
                                     style="-fx-font-size: 12; -fx-text-fill: #1a3a2a;" onAction="#handleVideoToggle"
                                     toggleGroup="$videoToggleGroup" />
                    </HBox>
                    <VBox fx:id="videoLinkBox" spacing="8.0">
                        <TextField fx:id="videoLinkField" promptText="https://your-video-link.com"
                                   style="-fx-background-color: white; -fx-border-color: #a8d8b8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-pref-height: 38; -fx-font-size: 12; -fx-padding: 0 12;" />
                    </VBox>
                    <HBox fx:id="videoFileBox" spacing="12.0" alignment="CENTER_LEFT" managed="false" visible="false">
                        <Button text="Choose File" onAction="#handleUploadVideo"
                                style="-fx-background-color: #f0ede6; -fx-text-fill: #1a3a2a; -fx-font-size: 12; -fx-border-color: #c8c0b0; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 7 14; -fx-cursor: hand;" />
                        <Label fx:id="videoPathLabel" text="No file selected"
                               style="-fx-font-size: 12; -fx-text-fill: #8a9a8a;" wrapText="true" maxWidth="320.0" />
                    </HBox>
                </VBox>

                <HBox spacing="12.0" alignment="CENTER_LEFT">
                    <Button text="Submit for Review" onAction="#handleSubmitMaterial"
                            prefHeight="42.0"
                            style="-fx-background-color: #1a3a2a; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 4; -fx-padding: 0 28; -fx-cursor: hand;" />
                    <Label fx:id="uploadStatusLabel" wrapText="true"
                           style="-fx-font-size: 12;" />
                </HBox>

            </VBox>
        </HBox>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" prefHeight="36.0"
              style="-fx-background-color: #edeae2;">
            <Label text="Authorised by the National Electoral Board  ·  All votes are encrypted and tamper-proof"
                   style="-fx-text-fill: #8a9a8a; -fx-font-size: 10;" />
        </HBox>
    </bottom>

</BorderPane>
